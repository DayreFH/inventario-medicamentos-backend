# Copia este archivo a .env y ajusta valores:
#   copy .env.example .env   (Windows, en la raíz del backend)

# MySQL — usuario, contraseña, host, puerto y nombre de BD
# Crea la base en MySQL antes de prisma db push (CREATE DATABASE ...;)
DATABASE_URL="mysql://root:TU_PASSWORD@localhost:3306/inventario_medicamentos"

PORT=4000
NODE_ENV=development

# Debe coincidir con la URL donde corre Vite (Opción A: clone frontend en :5173)
FRONTEND_URL=http://localhost:5173

# Genera uno seguro: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
